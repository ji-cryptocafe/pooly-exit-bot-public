# ---- RPC ----
# A single Base RPC endpoint. The public one below is fine to start with.
BASE_RPC_URL=https://mainnet.base.org

# ---- deployment ----
DEPLOYER_PRIVATE_KEY=        # set automatically by ./newkey.sh -- do not edit by hand
OWNER_ADDRESS=0xYOUR_WALLET_ADDRESS    # wallet HOLDING the przUSDC
RECEIVER_ADDRESS=0xYOUR_WALLET_ADDRESS # where recovered USDC lands (IMMUTABLE)
MIN_RATE_BPS=9999          # slippage floor vs par. IMMUTABLE once deployed -- redeploy to change.

# ---- bot ----
EXITOR_ADDRESS=0x...       # filled in after deploy
BOT_PRIVATE_KEY=           # set automatically by ./newkey.sh -- same key, gas only

MIN_ASSETS_USDC=5          # hard floor: never fire for less than this many USDC
MAX_GAS_PCT=2              # and never spend more than this % of the grab on gas
ETH_USD=4000               # only used to price that ratio; rough is fine
PRIORITY_GWEI=0.05         # raise to outbid competing exit bots
MAX_GAS_SPEND_ETH=0.02     # hard stop on total gas burn
POLL_MS=500
BLIND_FIRE_MS=0            # e.g. 30000 to also fire blind every 30s (~158k gas per miss)
SKIP_SIMULATION=false      # true = skip the pre-flight eth_call, pay for reverts, win more races
HEARTBEAT_MS=600000        # proof-of-life line every 10 min so silence != blindness
